# Variables seguras de ejemplo para Render o Docker local.
# No escribas secretos reales dentro del código del proyecto.
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=nextlevel-store-demo-jwt-secret-change-in-render-2026-very-long-key
JWT_EXPIRATION_MS=86400000
APP_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=Lax
JWT_COOKIE_SAME_SITE=Lax
GOOGLE_CLIENT_ID=tu_google_client_id
GOOGLE_CLIENT_SECRET=tu_google_client_secret
# Para base de datos real en nube usa MongoDB Atlas. Ejemplo:
# MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/nextlevel_db?retryWrites=true&w=majority
# Para que no pida login, pega aqui el src de "Publicar en la web" de Power BI.
POWERBI_PUBLIC_EMBED_URL=https://app.powerbi.com/view?r=eyJrIjoiZjI0Mzk1NGEtYTEyOC00M2JiLWFhYzQtOTc0ZDY3ZjMyZjg5IiwidCI6IjlkMTJiZjNmLWU0ZjYtNDdhYi05MTJmLTFhMmYwZmM0OGFhNCIsImMiOjR9
# POWERBI_EMBED_URL solo se usa si quieres probar el embed privado; puede pedir login.
POWERBI_EMBED_URL=
